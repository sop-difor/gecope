# Copie este arquivo para .env (nunca commitado — já coberto pelo .gitignore da raiz)
# e preencha os valores reais. Usado tanto por web/index.js quanto por worker/worker.js.

# Projeto Supabase do GECOPE
SUPABASE_URL=https://qexdnxqmiaarzwwwrcor.supabase.co

# Service role key (Supabase > Project Settings > API > service_role) — NUNCA a anon key
# aqui. Ignora RLS por design: é o que dá ao proxy/worker permissão de escrever em
# whatsapp_jobs/whatsapp_logs mesmo com as policies restritas a admin/authenticated.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key pública (a mesma já usada em config.js do front-end) — usada só para validar o
# JWT de sessão do usuário via auth.getUser(token), nunca para operações privilegiadas.
SUPABASE_ANON_KEY=

# Evolution API — dentro do docker-compose.yml, aponta para o serviço interno
# (http://evolution-api:8080), nunca uma URL pública.
EVO_API_URL=http://evolution-api:8080
EVO_API_KEY=
EVO_INSTANCE=SOP

# Porta interna do serviço web (o Caddy é quem fala com esta porta pela rede Docker —
# nunca publicada diretamente para a internet, ver docker-compose.yml)
PORT=3000

# Intervalo de polling do worker (ms)
POLL_INTERVAL_MS=2000

# Tempo (ms) que um job pode ficar em 'processing' antes de ser considerado travado e
# devolvido para 'pending' pelo worker (ex.: se o container morreu no meio do envio)
STALE_PROCESSING_MS=300000

# Domínio público apontando (registro DNS tipo A) para o IP da VM — usado pelo Caddy para
# emitir o certificado TLS automaticamente via Let's Encrypt. Ex.: whatsapp.seudominio.com
DOMAIN=
